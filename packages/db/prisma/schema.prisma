generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Inbox ───────────────────────────────────────────────────

enum OrigemInbox {
  telegram
  web
}

enum TipoMidia {
  texto
  audio
  foto
  link
  documento
}

enum StatusInbox {
  pendente
  processado
  erro
  ignorado
}

model InboxItem {
  id                  String      @id @default(cuid())
  origem              OrigemInbox
  tipoMidia           TipoMidia   @map("tipo_midia")
  conteudoBruto       String      @map("conteudo_bruto") @db.Text
  transcricao         String?     @db.Text
  arquivoUrl          String?     @map("arquivo_url")
  telegramMessageId   String?     @unique @map("telegram_message_id")
  status              StatusInbox @default(pendente)
  erroDetalhes        String?     @map("erro_detalhes") @db.Text
  criadoEm            DateTime    @default(now()) @map("criado_em")

  tarefas             Tarefa[]
  notas               Nota[]

  userId String? @map("user_id")

  @@index([userId])
  @@map("inbox_items")
}

// ── Projetos ────────────────────────────────────────────────

enum TipoProjeto {
  cliente
  interno
  pessoal
}

model Projeto {
  id               String      @id @default(cuid())
  nome             String
  tipo             TipoProjeto @default(cliente)
  cor              String      @default("#ff5a3d")
  ativo            Boolean     @default(true)
  metaVideosMensal Int         @default(10) @map("meta_videos_mensal")

  tarefas         Tarefa[]
  videos          Video[]
  eventos         Evento[]
  notas           Nota[]
  entregasMensais EntregaMensal[]

  userId String? @map("user_id")

  @@index([userId])
  @@map("projetos")
}

model EntregaMensal {
  id        String   @id @default(cuid())
  titulo    String
  formato   String   @default("outro")
  concluido Boolean  @default(false)
  mes       Int      // 1-12
  ano       Int      // 2026
  projetoId String?  @map("projeto_id")
  // Preenchido quando a entrega nasce do Pipeline (vídeo que chegou em ENVIADO).
  // Entregas cadastradas à mão continuam com videoId nulo.
  videoId   String?  @unique @map("video_id")
  criadoEm  DateTime @default(now()) @map("criado_em")

  projeto   Projeto? @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: SetNull)

  userId String? @map("user_id")

  @@index([userId])
  @@map("entregas_mensais")
}

// ── Tarefas ─────────────────────────────────────────────────

enum StatusTarefa {
  aberta
  fazendo
  concluida
  cancelada
}

enum Prioridade {
  baixa
  media
  alta
  urgente
}

model Tarefa {
  id            String        @id @default(cuid())
  titulo        String
  descricao     String?       @db.Text
  projetoId     String?       @map("projeto_id")
  prazo         DateTime?
  prioridade    Prioridade    @default(media)
  status        StatusTarefa  @default(aberta)
  recorrencia   String?       // "diaria", "semanal", "seg,qua,sex"
  origemInboxId String?       @map("origem_inbox_id")
  todoistId     String?       @map("todoist_id")
  criadoEm      DateTime      @default(now()) @map("criado_em")
  atualizadoEm  DateTime      @updatedAt @map("atualizado_em")

  projeto       Projeto?      @relation(fields: [projetoId], references: [id])
  origemInbox   InboxItem?    @relation(fields: [origemInboxId], references: [id])

  userId String? @map("user_id")

  @@index([userId])
  @@map("tarefas")
}

// ── Vídeos ──────────────────────────────────────────────────

enum FormatoVideo {
  reels
  vsl
  criativo
  aula
  institucional
  outro
}

enum EstagioVideo {
  briefing
  material_recebido
  cortando
  primeiro_corte
  revisao
  ajustes
  aprovado
  entregue
}

enum AguardandoQuem {
  eu
  cliente
  gravacao
  aprovacao
}

model Video {
  id                String        @id @default(cuid())
  titulo            String
  projetoId         String?       @map("projeto_id")
  formato           FormatoVideo  @default(outro)
  estagio           EstagioVideo  @default(briefing)
  prazoEntrega      DateTime?     @map("prazo_entrega")
  estimativaHoras   Float?        @map("estimativa_horas")
  horasReais        Float?        @map("horas_reais")
  aguardando        AguardandoQuem? @default(eu)
  linkBruto         String?       @map("link_bruto")
  linkEntrega       String?       @map("link_entrega")
  rodadasAlteracao  Int           @default(0) @map("rodadas_alteracao")
  criadoEm          DateTime      @default(now()) @map("criado_em")
  entregueEm        DateTime?     @map("entregue_em")

  projeto           Projeto?      @relation(fields: [projetoId], references: [id])
  videoEventos      VideoEvento[]
  sessoesFoco       SessaoFoco[]
  notas             Nota[]
  entregaMensal     EntregaMensal?

  userId String? @map("user_id")

  @@index([userId])
  @@map("videos")
}

model VideoEvento {
  id          String       @id @default(cuid())
  videoId     String       @map("video_id")
  deEstagio   EstagioVideo @map("de_estagio")
  paraEstagio EstagioVideo @map("para_estagio")
  criadoEm    DateTime     @default(now()) @map("criado_em")

  video       Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("video_eventos")
}

model SessaoFoco {
  id              String    @id @default(cuid())
  videoId         String    @map("video_id")
  inicio          DateTime  @default(now())
  fim             DateTime?
  duracaoMinutos  Int?      @map("duracao_minutos")

  video           Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("sessoes_foco")
}

// ── Eventos (Agenda) ────────────────────────────────────────

model Evento {
  id             String    @id @default(cuid())
  titulo         String
  inicio         DateTime
  fim            DateTime?
  local          String?
  recorrencia     String?   // "unico", "semanal", "mensal"
  projetoId      String?   @map("projeto_id")
  googleEventId  String?   @unique @map("google_event_id")
  origem         String?   // "telegram", "web", "google"
  criadoEm       DateTime  @default(now()) @map("criado_em")

  projeto        Projeto?  @relation(fields: [projetoId], references: [id])

  userId String? @map("user_id")

  @@index([userId])
  @@map("eventos")
}

// ── Notas ───────────────────────────────────────────────────

model Nota {
  id            String    @id @default(cuid())
  titulo        String?
  conteudo      String    @db.Text
  tags          String[]  @default([])
  projetoId     String?   @map("projeto_id")
  videoId       String?   @map("video_id")
  origemInboxId String?   @map("origem_inbox_id")
  criadoEm      DateTime  @default(now()) @map("criado_em")
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em")

  projeto       Projeto?   @relation(fields: [projetoId], references: [id])
  video         Video?     @relation(fields: [videoId], references: [id])
  origemInbox   InboxItem? @relation(fields: [origemInboxId], references: [id])

  userId String? @map("user_id")

  @@index([userId])
  @@map("notas")
}

// ── Referências ─────────────────────────────────────────────

// Links uteis, agrupados em colecoes (ex.: "Conteudo", "Trafego 2026", "IAs").
model Referencia {
  id         String   @id @default(cuid())
  url        String
  titulo     String?
  descricao  String?
  colecao    String?
  favorito   Boolean  @default(false)
  ordem      Int      @default(0)
  tags       String[] @default([])
  observacao String?  @db.Text
  thumbnail  String?
  criadoEm   DateTime @default(now()) @map("criado_em")

  userId String? @map("user_id")

  @@index([userId])
  @@map("referencias")
}

// ── Lembretes ───────────────────────────────────────────────

model LembreteEnviado {
  id         String   @id @default(cuid())
  tipo       String   // "prazo_24h", "video_travado", "resumo_diario"
  entidadeId String   @map("entidade_id")
  enviadoEm  DateTime @default(now()) @map("enviado_em")

  @@unique([tipo, entidadeId, enviadoEm])
  @@map("lembretes_enviados")
}

model LembreteAgendado {
  id               String   @id @default(cuid())
  mensagem         String
  horarioAlvo      DateTime @map("horario_alvo")
  horarioNotificar  DateTime @map("horario_notificar")
  enviado          Boolean  @default(false)
  chatId           String   @map("chat_id")
  criadoEm         DateTime @default(now()) @map("criado_em")

  userId String? @map("user_id")

  @@index([userId])
  @@map("lembretes_agendados")
}


// ── Better Auth (login por e-mail e senha) ──────────────────────
// Nomes de tabela em minúsculo, como o adapter do Better Auth espera.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  // Chat do Telegram cujas mensagens caem nos dados deste usuário
  telegramChatId String?  @unique @map("telegram_chat_id")
  // Foto de perfil (base64). Fora da sessão do Better Auth de propósito.
  avatarDataUrl  String?  @map("avatar_data_url") @db.Text
  // Cofre: salt do PBKDF2 e bloco cifrado usado so para conferir a senha
  cofreSalt        String?  @map("cofre_salt")
  cofreVerificador String?  @map("cofre_verificador") @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ── Cofre de logins e senhas ────────────────────────────────────
// `cifra` e AES-256-GCM feito no navegador; o servidor nunca tem a chave.
model CofreItem {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  nome         String
  categoria    String?
  favorito     Boolean  @default(false)
  cifra        String   @db.Text
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([userId])
  @@map("cofre_itens")
}
